#!/usr/bin/env python3
"""
MR-DASHBOARD // Fsociety Central Hub
Interactive TUI entry point for the custom toolsuite.
"""

import os
import sys
import subprocess
import shutil
import time
from pathlib import Path

# Цветовые коды ANSI
RED = "\033[1;31m"
GREEN = "\033[0;32m"
YELLOW = "\033[1;33m"
CYAN = "\033[0;36m"
WHITE = "\033[1;37m"
GRAY = "\033[90m"
RESET = "\033[0m"

BIN_DIR = Path.home() / ".local" / "bin"
NOTES_FILE = Path.home() / ".mr_notes.txt"
PROJECTS_DIR = Path.home() / "Project"

def get_sys_info():
    """Получаем легкую сводку по RAM и Uptime без тяжелых библиотек."""
    try:
        with open("/proc/meminfo", "r") as f:
            lines = f.readlines()
            total = int(lines[0].split()[1])
            free = int(lines[2].split()[1])
            used_pct = int(((total - free) / total) * 100)
            ram_str = f"{used_pct}%"
    except Exception:
        ram_str = "N/A"

    try:
        with open("/proc/uptime", "r") as f:
            uptime_sec = float(f.readline().split()[0])
            hours = int(uptime_sec // 3600)
            mins = int((uptime_sec % 3600) // 60)
            uptime_str = f"{hours}h {mins}m"
    except Exception:
        uptime_str = "N/A"

    return ram_str, uptime_str

def get_counters():
    """Считаем количество проектов и заметок."""
    notes_count = 0
    if NOTES_FILE.exists():
        try:
            with open(NOTES_FILE, "r", encoding="utf-8", errors="ignore") as f:
                notes_count = len([line for line in f if line.strip()])
        except Exception:
            pass

    proj_count = 0
    if PROJECTS_DIR.exists():
        try:
            proj_count = len([p for p in PROJECTS_DIR.iterdir() if p.is_dir()])
        except Exception:
            pass

    tools_count = len(list(BIN_DIR.glob("mr-*"))) if BIN_DIR.exists() else 0

    return proj_count, notes_count, tools_count

def render():
    os.system("clear")
    ram, uptime = get_sys_info()
    projects, notes, tools = get_counters()

    print(f"{RED}┌────────────────────────────────────────────────────────┐{RESET}")
    print(f"{RED}│                   FSOCIETY DASHBOARD                   │{RESET}")
    print(f"{RED}├────────────────────────────────────────────────────────┤{RESET}")
    print(f"{RED}│{RESET}                                                        {RED}│{RESET}")
    print(f"{RED}│{RESET}  {YELLOW}SYSTEM{RESET}                 {YELLOW}ENVIRONMENT{RESET}                    {RED}│{RESET}")
    print(f"{RED}│{RESET}  RAM Usage : {CYAN}{ram:<10}{RESET} Projects  : {WHITE}{projects:<12}{RESET} {RED}│{RESET}")
    print(f"{RED}│{RESET}  Uptime    : {CYAN}{uptime:<10}{RESET} Notes     : {WHITE}{notes:<12}{RESET} {RED}│{RESET}")
    print(f"{RED}│{RESET}                         Active Tools: {WHITE}{tools:<12}{RESET} {RED}│{RESET}")
    print(f"{RED}│{RESET}                                                        {RED}│{RESET}")
    print(f"{RED}├────────────────────────────────────────────────────────┤{RESET}")
    print(f"{RED}│{RESET}                                                        {RED}│{RESET}")
    print(f"{RED}│{RESET}  [{WHITE}P{RESET}] Projects ({CYAN}mr-project{RESET})   [{WHITE}N{RESET}] Notes ({CYAN}mr-notes{RESET})         {RED}│{RESET}")
    print(f"{RED}│{RESET}  [{WHITE}F{RESET}] Files ({CYAN}mr-termshell{RESET})   [{WHITE}T{RESET}] Top ({CYAN}mr-top{RESET})             {RED}│{RESET}")
    print(f"{RED}│{RESET}  [{WHITE}M{RESET}] Matrix ({CYAN}mr-matrix{RESET})     [{WHITE}H{RESET}] Help ({CYAN}mr-help{RESET})           {RED}│{RESET}")
    print(f"{RED}│{RESET}  [{WHITE}L{RESET}] Quick Look ({CYAN}mr-look{RESET})   [{WHITE}A{RESET}] ASCII Art ({CYAN}mr-ascii{RESET})      {RED}│{RESET}")
    print(f"{RED}│{RESET}                                                        {RED}│{RESET}")
    print(f"{RED}│{RESET}  {GRAY}[Q] Exit to Shell{RESET}                                    {RED}│{RESET}")
    print(f"{RED}└────────────────────────────────────────────────────────┘{RESET}")

def main():
    while True:
        render()
        try:
            choice = input(f"\n{RED}fsociety{RESET}@{CYAN}dash{RESET} > ").strip().lower()
        except (KeyboardInterrupt, EOFError):
            print("\n")
            break

        if choice in ('q', 'exit'):
            break
        elif choice == 'p':
            subprocess.run(["mr-project"])
        elif choice == 'n':
            subprocess.run(["mr-notes"])
        elif choice == 'f':
            subprocess.run(["mr-termshell"])
        elif choice == 't':
            subprocess.run(["mr-top"])
        elif choice == 'm':
            subprocess.run(["mr-matrix", "--red"])
        elif choice == 'h':
            subprocess.run(["mr-help"])
            input(f"\n{GRAY}Нажмите Enter чтобы вернуться в дашборд...{RESET}")
        elif choice == 'l':
            subprocess.run(["mr-look"])
            input(f"\n{GRAY}Нажмите Enter чтобы вернуться в дашборд...{RESET}")
        elif choice == 'a':
            subprocess.run(["mr-ascii"])
            input(f"\n{GRAY}Нажмите Enter чтобы вернуться в дашборд...{RESET}")

if __name__ == "__main__":
    main()
