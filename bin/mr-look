#!/usr/bin/env python3
import os
import sys
from pathlib import Path

def main():
    current_dir = Path.cwd()
    
    # Сортируем: сначала папки, потом файлы, по алфавиту (включая скрытые, но исключая . и ..)
    all_items = sorted(list(current_dir.iterdir()), key=lambda x: (not x.is_dir(), x.name.lower()))
    
    print(f"\033[1;31m--- MR-LOOK // {current_dir} ---\033[0m")
    
    valid_items = []
    screen_index = 0
    
    # Всегда добавляем переход наверх
    if current_dir != current_dir.root:
        valid_items.append(("..", current_dir.parent, True))
        print(f" \033[33m {screen_index}\033[0m) [..] (родительская папка)")
        screen_index += 1

    for entry in all_items:
        # Пропускаем только текущую и родительскую ссылки, если они попались вдруг
        if entry.name in ['.', '..']:
            continue
            
        is_dir = entry.is_dir()
        valid_items.append((entry.name, entry, is_dir))
        
        # Скрытые папки/файлы подсветим чуть темнее, чтобы отличались
        is_hidden = entry.name.startswith('.')
        if is_dir:
            color = "32;1" if not is_hidden else "32;2"
            tag = "/"
        else:
            color = "37" if not is_hidden else "90"
            tag = " "
            
        print(f" \033[36m{screen_index:2d}\033[0m) \033[{color}m{entry.name}{tag}\033[0m")
        screen_index += 1

    print("\n\033[90m[Число] - войти в папку (cd) | [c + Число] - прочитать файл (cat) | [q] - выход\033[0m")
    choice = input("\033[31m> \033[0m").strip()

    if not choice or choice.lower() == 'q':
        return

    action = "cd"
    if choice.lower().startswith('c'):
        action = "cat"
        choice = choice[1:].strip()

    try:
        index = int(choice)
        if 0 <= index < len(valid_items):
            target_name, target_path, is_dir = valid_items[index]
            
            if action == "cat":
                if is_dir:
                    print("\033[31m[-] Это папка, а не файл.\033[0m")
                else:
                    print(f"\n\033[1;32m=== CAT: {target_name} ===\033[0m")
                    os.system(f"cat '{target_path}'")
                    print(f"\033[1;32m===============================\033[0m\n")
            else:
                if is_dir:
                    # Записываем путь в файл-мост для оболочки
                    cache_file = Path.home() / ".cache" / "mr_look_cd"
                    cache_file.parent.mkdir(parents=True, exist_ok=True)
                    with open(cache_file, "w") as f:
                        f.write(str(target_path))
                else:
                    print(f"\033[31m[-] Это файл. Используй c{choice} для просмотра.\033[0m")
        else:
            print("\033[31m[-] Неверный номер.\033[0m")

    except ValueError:
        print("\033[31m[-] Неверный ввод.\033[0m")

if __name__ == "__main__":
    main()
