#!/usr/bin/env python3
import sys
import socket
import os

if len(sys.argv) == 1:
    os.system('alacritty --class "mr_float_term" -e python3 ' + __file__ + ' --window')
    sys.exit()

print("\033[1;31m=== FSOCIETY PORT CHECKER ===\033[0m\n")

target_host = input("Enter Target IP/Domain: ")
target_port = input("Enter Port (e.g. 80, 22, 443): ")

try:
    port = int(target_port)
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(2.0) # ждем ответ 2 секунды
    
    result = s.connect_ex((target_host, port))
    
    if result == 0:
        print(f"\n\033[1;32m[+] Port {port} is OPEN on {target_host}!\033[0m")
    else:
        print(f"\n\033[1;31m[-] Port {port} is CLOSED or Filtered.\033[0m")
        
    s.close()
except Exception as e:
    print(f"\nError: {e}")

print("\n-----------------------------------")
input("Press Enter to exit...")
